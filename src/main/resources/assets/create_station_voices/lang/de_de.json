  "itemGroup.create_station_voices.main": "Create: Station Voices",
  "create_station_voices.ponder.announcer_block.header": "Benutzung des Redstone-Ansageblocks",
  "create_station_voices.ponder.announcer_block.text_1": "Der Redstone-Ansageblock spielt benutzerdefinierte Text-to-Speech-Ansagen ab",
  "create_station_voices.ponder.announcer_block.text_2": "Mache einen Rechtsklick auf den Block, um Text, Stimme, Tonhöhe, Hall und Effekte zu konfigurieren",
  "create_station_voices.ponder.announcer_block.text_3": "Befeuere den Ansageblock mit einem Redstone-Signal, um die Ansage auszulösen",
  "create_station_voices.ponder.announcer_block.text_4": "Während der Wiedergabe leuchtet der Ansageblock auf und überträgt den Ton an Spieler in der Nähe",
  "create_station_voices.ponder.announcer_block.text_5": "Optionale Jingles (wie z.B. der DB-Gong) können so konfiguriert werden, dass sie vorher, nachher oder beides abgespielt werden!",
  "create_station_voices.ponder.configurable_announcer_block.header": "Automatisierung von Bahnhofsansagen",
  "create_station_voices.ponder.configurable_announcer_block.text_1": "Der konfigurierbare Ansageblock automatisiert Ansagen für dein Zugnetzwerk",
  "create_station_voices.ponder.configurable_announcer_block.text_2": "Mache einen Rechtsklick auf einen Bahnhof oder Gleisbeobachter mit dem Ansageblock in der Hand, um ihn zu verknüpfen",
  "create_station_voices.ponder.configurable_announcer_block.text_3": "Klicke im Menü auf 'Autom. abrufen', um automatisch Züge zu laden, die fahrplanmäßig an diesem Bahnhof halten",
  "create_station_voices.ponder.configurable_announcer_block.text_4": "Jeder Zug kann komplett individuell angepasste Ansagetexte, Stimmen und Effekte besitzen",
  "create_station_voices.ponder.configurable_announcer_block.text_5": "Wenn ein fahrplanmäßiger Zug ankommt, löst der Ansageblock automatisch aus!",
  "create_station_voices.ponder.train_announcer_block.header": "Benutzung des zugmontierten Ansageblocks",
  "create_station_voices.ponder.train_announcer_block.text_1": "Der zugmontierte Ansageblock wird direkt auf Zugwaggons platziert",
  "create_station_voices.ponder.train_announcer_block.text_2": "Mache einen Rechtsklick, um Ansagen für jeden ankommenden Bahnhof zu konfigurieren, selbst im zusammengebauten Zustand",
  "create_station_voices.ponder.train_announcer_block.text_3": "Nutze 'Autom. abrufen', um automatisch Bahnhöfe aus dem Zugfahrplan zu laden",
  "create_station_voices.ponder.train_announcer_block.text_4": "Bei der Ankunft an einem konfigurierten Bahnhof wird die Ansage im Inneren des Zuges abgespielt!",
  "create_station_voices.ponder.train_announcer_block.text_5": "Aktiviere 'Nur im Zug' im Effekte-Tab, damit nur Passagiere im Zug die Durchsage hören",
  "create_station_voices.ponder.speaker_block.header": "Verwendung von Lautsprechern als Audio-Relais",
  "create_station_voices.ponder.speaker_block.text_1": "Lautsprecher fungieren als sekundäre Audioquellen für Ansageblöcke",
  "create_station_voices.ponder.speaker_block.text_2": "Mache einen Rechtsklick auf einen Ansageblock mit dem Lautsprecher in der Hand, um sie zu verbinden",
  "create_station_voices.ponder.speaker_block.text_3": "Wenn der Ansageblock eine Ansage abspielt, geben alle verbundenen Lautsprecher den Ton gleichzeitig wieder!",
  "create_station_voices.ponder.speaker_block.text_4": "Verteile Lautsprecher an Bahnhöfen und Bahnsteigen, damit Ansagen überall zu hören sind",
  "create_station_voices.ponder.announcer_display_link.header": "Anzeigen von Ansagen auf Bildschirmen",
  "create_station_voices.ponder.announcer_display_link.text_1": "Display-Verknüpfungen können Ansagen von Ansageblöcken auslesen",
  "create_station_voices.ponder.announcer_display_link.text_2": "Mache zuerst einen Rechtsklick auf die Ziel-Anzeigetafel, das Schild oder die Nixie-Röhre...",
  "create_station_voices.ponder.announcer_display_link.text_3": "...platziere dann die Display-Verknüpfung an einem Ansageblock",
  "create_station_voices.ponder.announcer_display_link.text_4": "Passe in der Benutzeroberfläche die Bezeichnung an und wähle zwischen 'Während Wiedergabe' oder 'Dauerhaft anzeigen'",
  "create_station_voices.ponder.announcer_display_link.text_5": "Wenn eine Ansage abgespielt wird, wird der passende Text sofort an die Anzeige gesendet!",
  "create_station_voices.ponder.announcer_display_link.text_6": "Dies funktioniert mit Redstone-Ansageblöcken, konfigurierbaren Zug-Ansageblöcken und verbundenen Lautsprechern",
